# Dependency Directories
node_modules/
jspm_packages/
web_stage/

# Local Environment / Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Local Databases (SQLite Fallbacks)
*.db
*.db-journal
*.db-shm
*.db-wal
app/src/backend/*.db
app/src/backend/*.db-journal
app/src/backend/*.db-shm
app/src/backend/*.db-wal

# Build Outputs & Production Bundles
dist/
build/
out/
.next/
.nuxt/
app/src/frontend/dist/

# Log Files & Debugging Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
app/src/backend/*.log

# IDEs and Text Editors
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Test Caches & Reports
coverage/
.nyc_output/
.eslintcache
.stylelintcache
.parcel-cache
.cache/
