# -----------------------------------------------------------------------------
# AWS Production Infra Note Taker - Backend Environment Configuration
# Copy this file to '.env' and adjust values for local development
# -----------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development # Set to 'production' in AWS EC2/ECS
LOG_LEVEL=debug       # Options: error, warn, info, verbose, debug

# CORS Configuration
# Comma-separated list of allowed origins. Use '*' to allow all, or specify your S3/CloudFront URL.
ALLOWED_ORIGINS=http://localhost:5173

# Option A: Local SQLite Database Configuration (Default when Postgres vars are missing)
SQLITE_DB_PATH=notes.db

# Option B: AWS RDS PostgreSQL Database Configuration (Takes precedence over SQLite)
# PGHOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
# PGUSER=postgres
# PGPASSWORD=your-rds-master-password
# PGDATABASE=notetaker
# PGPORT=5432
# PGSSL=true # Enable SSL/TLS for AWS RDS security (highly recommended)

# Alternative standard single connection string (if preferred)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
